# Local Edge Function secrets. Copy to supabase/functions/.env (gitignored); `supabase functions serve`
# reads it. These values point the diagnose function at the fake plant.id server the local tests
# start (supabase/tests/local/fakeKindwise.mjs). Production sets only KINDWISE_API_KEY, with
# `supabase secrets set`, and never KINDWISE_BASE_URL (it defaults to https://plant.id).
KINDWISE_API_KEY=local-test-key
KINDWISE_BASE_URL=http://host.docker.internal:54399

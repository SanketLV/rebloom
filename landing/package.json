{
  "name": "rebloom-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:site": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build": "npm run build:site && node scripts/check-dist.mjs",
    "check": "node scripts/check-dist.mjs",
    "preview": "npm run build:site && vite preview",
    "test": "vitest run"
  },
  "browserslist": [
    "safari >= 14",
    "ios_saf >= 14",
    "chrome >= 87",
    "firefox >= 78",
    "edge >= 88"
  ],
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
